build
.claude
*.mdb

# clangd index cache (written into the source root by the language server)
.cache/

# app temp root (vpipe::temp_root) when a process runs from the source tree
.vpipe-tmp/

# MLX is no longer a submodule; a local checkout here is untracked and is
# only ever an optional side-by-side reference (see the acknowledgement in
# README.md for the kernel headers vpipe actually vendors).
extern/mlx/
