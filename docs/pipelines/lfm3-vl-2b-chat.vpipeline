{
  "id": "lfm3-vl-2b-chat",
  "stages": [
    {
      "id": "tx",
      "type": "feedback-tx",
      "config": {
        "from": "rx"
      }
    },
    {
      "id": "sampler",
      "type": "sampler-select",
      "config": {
        "temperature": 0.1,
        "top_k": 50,
        "top_p": 1.0,
        "min_p": 0.0,
        "repetition_penalty": 1.1,
        "presence_penalty": 0.0,
        "seed": 0
      }
    },
    {
      "id": "input",
      "type": "text-input",
      "iports": [
        {
          "src": "tx",
          "oport": 0
        }
      ],
      "config": {
        "prompt": "you> ",
        "count": 0,
        "present_first_without_beat": true,
        "media": true
      }
    },
    {
      "id": "chat",
      "type": "text-chat",
      "iports": [
        {
          "src": "input",
          "oport": 0
        },
        {
          "src": "sampler",
          "oport": 0
        }
      ],
      "config": {
        "hf_dir": "LiquidAI/LFM3-VL-2B",
        "compute_dtype": "f16",
        "page_tokens": 1024,
        "max_pages": 64,
        "max_new_tokens": 8192,
        "enable_tools": false
      }
    },
    {
      "id": "rx",
      "type": "feedback-rx",
      "iports": [
        {
          "src": "chat",
          "oport": 0
        }
      ]
    }
  ],
  "subpipelines": []
}
