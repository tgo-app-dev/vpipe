{
  "id": "vosr-2-restore",
  "stages": [
    {
      "id": "load-image",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": [
          "low-quality.jpg"
        ]
      }
    },
    {
      "id": "image-resample",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-image",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1024,
        "fit": "crop",
        "algorithm": "bicubic"
      }
    },
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "VOSR-2.0"
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "image-resample",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "park"
      }
    },
    {
      "id": "vae-encode",
      "type": "vae-encode",
      "iports": [
        {
          "src": "image-resample",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "generate-image",
      "type": "generate-image",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "vae-encode",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        }
      ],
      "config": {
        "seed": 42
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-image",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "image-resample",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "compare-image",
      "type": "compare-image",
      "iports": [
        {
          "src": "image-resample",
          "oport": 0
        },
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "save-image",
      "type": "save-image",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "path": "vosr-restored.png"
      }
    }
  ],
  "subpipelines": [],
  "aux": {}
}
