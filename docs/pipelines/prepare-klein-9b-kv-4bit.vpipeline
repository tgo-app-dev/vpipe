{
  "id": "prepare-klein-9b-kv-4bit",
  "stages": [
    {
      "id": "fetch",
      "type": "model-fetch",
      "config": {
        "model_path": "black-forest-labs/FLUX.2-klein-9b-kv",
        "hf_token": "",
        "base_path": "./models",
        "skip_existing_files": true,
        "overwrite_existing": false
      }
    },
    {
      "id": "quant-dit",
      "type": "model-quantize",
      "iports": [ { "src": "fetch", "oport": 0 } ],
      "config": {
        "src_model": "black-forest-labs/FLUX.2-klein-9b-kv",
        "output_name": "local/FLUX.2-klein-9b-kv-4bit-dit",
        "target": "dit",
        "bits": 4,
        "group_size": 64,
        "skip_existing": false,
        "awq": true,
        "awq_clip": true,
        "klein_kv": true
      }
    },
    {
      "id": "quant-enc",
      "type": "model-quantize",
      "iports": [ { "src": "quant-dit", "oport": 0 } ],
      "config": {
        "src_model": "local/FLUX.2-klein-9b-kv-4bit-dit",
        "output_name": "local/FLUX.2-klein-9b-kv-4bit",
        "target": "text_encoder",
        "bits": 4,
        "group_size": 64,
        "skip_existing": false,
        "awq": true,
        "awq_clip": true
      }
    },
    {
      "id": "remove-dit-intermediate",
      "type": "model-remove",
      "iports": [ { "src": "quant-enc", "oport": 0 } ],
      "config": {
        "model": "local/FLUX.2-klein-9b-kv-4bit-dit",
        "delete_files": true,
        "missing_ok": true
      }
    }
  ]
}
