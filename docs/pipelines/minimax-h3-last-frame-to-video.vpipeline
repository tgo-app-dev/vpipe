{
  "id": "minimax-h3-last-frame-to-video",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "local/MiniMax-H3-FL2VA-8bit"
      }
    },
    {
      "id": "load-image",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": [
          "reference.jpg"
        ]
      }
    },
    {
      "id": "last-frame",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-image",
          "oport": 0
        }
      ],
      "config": {
        "width": 960,
        "height": 544,
        "fit": "crop",
        "algorithm": "lanczos"
      }
    },
    {
      "id": "vae-encode-last",
      "type": "vae-encode",
      "iports": [
        {
          "src": "last-frame",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "always"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "The shot ENDS exactly on picture 1. It opens wider and further back on the same place, the scene already in motion, and the camera glides slowly in, the subjects moving naturally as it goes, until it settles on the framing of picture 1 for the final moment and holds there. Natural ambient sound that matches the scene. No text, no captions."
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "last-frame",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "always"
      }
    },
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "video_shift": 12.0,
        "audio_shift": 3.0,
        "condition_timestep": 1.0,
        "audio_seconds": 0.0,
        "lora": "larryvrh/MiniMax-H3-Turbo-Lora-v4-600-ema",
        "lora_scale": 1.0
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "vae-encode-last",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        }
      ],
      "config": {
        "height": 544,
        "width": 960,
        "frames": 124,
        "fps": 24,
        "steps": 6,
        "seed": 11,
        "i8_gemm": true,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "audio-vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "output_url": "minimax-h3-last-frame-to-video.mp4",
        "enable_video": true,
        "enable_audio": true
      }
    }
  ],
  "subpipelines": []
}
