{
  "id": "minimax-h3-text-to-video",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "local/MiniMax-H3-FL2VA-4bit"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "A red paper boat drifting down a rain-slicked gutter at dusk, street light reflections rippling on the water. Sound of the rain is heard with occasional sound of individual water drops."
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "always"
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        }
      ],
      "config": {
        "height": 544,
        "width": 960,
        "frames": 120,
        "fps": 24,
        "steps": 8,
        "seed": 6,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "audio-vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "output_url": "/minimax-h3-text-to-video.mp4",
        "enable_video": true,
        "enable_audio": true
      }
    }
  ],
  "subpipelines": []
}
