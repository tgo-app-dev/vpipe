{
  "id": "minimax-h3-image-train-lora-edit",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "MiniMaxAI/MiniMax-H3-Image"
      }
    },
    {
      "id": "dataset",
      "type": "training-dataset",
      "iports": [
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "dir": "lora-datasets/my-edit-pairs",
        "trigger_word": "ohwx",
        "resolution": [
          1024
        ],
        "preview_prompts": [
          "a photo of {trigger} figurine in a snowy park"
        ]
      }
    },
    {
      "id": "optimizer",
      "type": "optimizer-select",
      "iports": [],
      "config": {
        "optimizer": "adamw",
        "learning_rate": 0.0002,
        "lr_schedule": "constant"
      }
    },
    {
      "id": "video-ref-encoder",
      "type": "video-ref-encoder",
      "iports": [
        {
          "src": "dataset",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "references_from_prompt": true,
        "seed": 42
      }
    },
    {
      "id": "vae-encode",
      "type": "vae-encode",
      "iports": [
        {
          "src": "dataset",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "train",
      "type": "train-lora",
      "iports": [
        {
          "src": "video-ref-encoder",
          "oport": 0
        },
        {
          "src": "vae-encode",
          "oport": 0
        },
        {
          "src": "dataset",
          "oport": 2
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "optimizer",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "video-ref-encoder",
          "oport": 1
        },
        {
          "src": "video-ref-encoder",
          "oport": 2
        }
      ],
      "config": {
        "output_dir": "lora-output",
        "name": "my-edit-h3i",
        "rank": 32,
        "targets": "attn_ff",
        "preview_steps": 6
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "train",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "save-image",
      "type": "save-image",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "path": "lora-output/preview-%04d.png",
        "format": "png"
      }
    }
  ],
  "subpipelines": []
}
