{
  "id": "minimax-h3-image-edit",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "MiniMaxAI/MiniMax-H3-Image"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "The dark, warmly lit podcast studio photograph of two hosts behind a wooden desk in <Picture 1> is <Subject 1>. <Subject 1> is mostly preserved: the large \"EP. 47\" title in the top right corner, the dark textured wall, the wooden shelves with plants, a brass globe, a lit candle, books and the \"DISCIPLINE > MOTIVATION\" chalkboard, the framed \"COMPOUND CONSISTENCY CONFIDENCE\" poster, the glowing floor lamp on the left and the table lamp on the right, the two black microphones on their stands, the black \"INVEST IN YOURSELF\" and \"PLAN BUILD WEALTH\" mugs, the carved wooden \"MONEY TALKS\" desk sign, the dark wooden desk, both hosts' faces, smiles and clothing, the man's wristwatch and the woman's hoop earrings all stay exactly the same. Only the headphones and the hosts' poses change. The over-ear headphones and their cable are removed from the man on the left, and his short, tousled dark brown curly hair is filled in naturally over the top and sides of his head where the headband had flattened it, leaving no dent or mark. The two hosts lean toward each other and bump fists directly above the \"MONEY TALKS\" sign: one fist from each host meets with the knuckles touching, both elbows lifted off the desk, so the fist bump sits exactly at the horizontal centre of the frame, midway between the two microphones. The target image is a square, cinematic photograph of the podcast set: the man in the black crew-neck sweater on the left and the woman with long wavy brown hair in the cream knit sweater on the right lean in and smile at each other, their forearms raised so the touching fists hover just above the top edge of the \"MONEY TALKS\" sign between the two microphones, while the warm lamp light, the dark shelves behind them and the \"EP. 47\" title in the top right keep the original moody lighting and colors."
      }
    },
    {
      "id": "load-picture",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": "minimax-h3-image-reference1.png"
      }
    },
    {
      "id": "video-ref-encoder",
      "type": "video-ref-encoder",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "load-picture",
          "oport": 0
        }
      ],
      "config": {
        "seed": 1234,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {}
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "video-ref-encoder",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "video-ref-encoder",
          "oport": 1
        },
        {
          "src": "video-ref-encoder",
          "oport": 2
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        }
      ],
      "config": {
        "width": 4096,
        "height": 4096,
        "seed": 1234,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "save-image",
      "type": "save-image",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        }
      ],
      "config": {
        "path": "minimax-h3-image-edit.png"
      }
    }
  ],
  "subpipelines": []
}
