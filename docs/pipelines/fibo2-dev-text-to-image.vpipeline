{
  "id": "fibo2-dev-text-to-image",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "briaai/Fibo-2.0-dev"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "{\"short_description\":\"A red bicycle leaning against a white brick wall on a sunny morning.\",\"objects\":[{\"description\":\"a red city bicycle with a wicker basket\",\"location\":\"center\"}],\"background_setting\":\"a white brick wall with a green door\",\"lighting\":{\"conditions\":\"bright morning sun\",\"direction\":\"from the right\"},\"style_medium\":\"photograph\"}"
      }
    },
    {
      "id": "negative-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "{\"short_description\":\"\",\"objects\":[{\"description\":\"the main subject\",\"texture\":\"smooth, featureless, plastic-like, airbrushed, no fine surface detail\",\"appearance_details\":\"soft blurred edges, simplified shapes, no fine detail\",\"skin_tone_and_texture\":\"waxy airbrushed skin, poreless, plastic smooth\"}],\"background_setting\":\"a plain seamless studio backdrop, perfectly smooth gradient, blurred and featureless, no visible texture\",\"lighting\":{},\"aesthetics\":{\"artifacts\":[\"oversaturated colours\",\"neon colour cast\",\"overexposed highlights\",\"lens flare\",\"slight blur\",\"motion blur\",\"haze\"]},\"photographic_characteristics\":{\"depth_of_field\":\"shallow, heavy bokeh obscuring most of the frame\",\"focus\":\"soft, slightly out of focus, lacking fine texture\"},\"style_medium\":\"\",\"context\":\"\",\"artistic_style\":\"\"}"
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "negative-prompt",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "fibo2-model-config",
      "type": "fibo2-model-config",
      "iports": [],
      "config": {
        "guidance_scale": 5.0
      }
    },
    {
      "id": "generate-image",
      "type": "generate-image",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "diffusion-conditioner",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "fibo2-model-config",
          "oport": 0
        }
      ],
      "config": {
        "width": 1024,
        "height": 1024,
        "steps": 50,
        "seed": 0
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-image",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "save-image",
      "type": "save-image",
